{
  "manifest_version": 3,
  "name": "Glint Reader: reads any web page aloud, word by word",
  "short_name": "Glint Reader",
  "version": "0.2.5",
  "description": "Reads any web page aloud right where it is, highlighting each word on the page as it is spoken.",
  "homepage_url": "https://navica.llc/tools/glint-reader/",
  "minimum_chrome_version": "128",
  "permissions": ["tts", "ttsEngine", "offscreen", "storage", "activeTab", "scripting",
    "contextMenus"],
  "tts_engine": {
    "voices": [
      { "voice_name": "Heart (Glint built-in)", "lang": "en-US",
        "event_types": ["start", "word", "end", "error"] },
      { "voice_name": "Bella (Glint built-in)", "lang": "en-US",
        "event_types": ["start", "word", "end", "error"] },
      { "voice_name": "Michael (Glint built-in)", "lang": "en-US",
        "event_types": ["start", "word", "end", "error"] },
      { "voice_name": "Emma (Glint built-in)", "lang": "en-GB",
        "event_types": ["start", "word", "end", "error"] }
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Glint Reader (Alt+Shift+R)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "commands": {
    "toggle-reader": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Start or stop reading on the current tab"
    }
  }
}
